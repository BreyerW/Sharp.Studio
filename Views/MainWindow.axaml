<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:Sharp.Studio.Models"
        xmlns:v="using:Sharp.Studio.Views"
		xmlns:s="using:Sharp.Studio"
        xmlns:vm="using:Sharp.Studio.ViewModels"
        xmlns:vms="using:Sharp.DockManager.ViewModels"
        xmlns:dc="using:Sharp.DockManager"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Sharp.Studio.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Sharp.Studio"
		dc:DockManager.AllowLastClose="False"
		>
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

	<v:ComplexDockable dc:DockManager.AllowDropArea="Left, Right" PreviewBrush="rgba(144,238,144,0.33)" Theme="{StaticResource CustomComplexDockable}" >
		<v:ComplexDockable.ItemsSource>
			<m:DockableFirstView/>
			<m:DockableSecondView/>
			<m:DockableFirstView/>
		</v:ComplexDockable.ItemsSource>

	</v:ComplexDockable>
</Window>
